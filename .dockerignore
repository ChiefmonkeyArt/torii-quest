# Operator key material (audit F14) — keep private keys out of the build context
kami-priv.hex
*.priv.hex
.secrets/

# Operator environment (audit F15) — `COPY . .` must not admit local secrets
.env
.env.*
!.env.example

# Build artefacts (regenerated inside the image)
node_modules
dist
dist-ssr

# VCS / CI
.git
.gitignore
.github

# Tests + docs not needed for the build
tests
**/*.md
**/*.mdx
LICENSE

# Dev tooling / temp
*.log
.DS_Store
tmp
.cache
uploaded_attachments
space_files
current_session_context
skills
