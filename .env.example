# Copy to .env and fill in.  NEVER commit a real .env.

# Your domain pointing (via an A record) at this server's IP.
# Caddy obtains a Let's Encrypt cert for this hostname automatically.
DOMAIN=quest.example.com

# Email Let's Encrypt uses for expiry/renewal notices.
ACME_EMAIL=you@example.com

# NOTE: the multiplayer server's admin identity (QUEST_ADMIN_NPUB) is NOT set
# here - arena-ws.js reads it directly from the process environment, not this
# file. It lives in the torii-arena-ws.service systemd unit instead. See
# VPS_INSTALL.md §16.2a - do this before your first boot, or nobody (including
# you) gets admin on your instance.
