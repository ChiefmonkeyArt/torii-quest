# Copy to .env and fill in.  NEVER commit a real .env.
# (./install.sh does this for you interactively.)

# Your domain pointing (via an A record) at this server's IP.
# Caddy obtains a Let's Encrypt cert for this hostname automatically.
DOMAIN=quest.example.com

# Email Let's Encrypt uses for expiry/renewal notices.
ACME_EMAIL=you@example.com

# Multiplayer server admin identity — the ONE npub that gets admin powers
# (Update Now, etc.) on this instance. Accepts npub1... only, never an nsec
# (nsec is a private key — never paste it anywhere). Leave blank and nobody,
# including you, gets admin. See VPS_INSTALL.md §16.2a.
QUEST_ADMIN_NPUB=

# --- Multiplayer tuning (optional — sane defaults if left blank) ---------
# Max simultaneous players per arena instance.
MAX_PEERS=32
# authoritative | relay — see MP_1_SPEC.md / MP_2_SPEC.md for the difference.
MP_MODE=authoritative
# Lag-compensation window in ms for hit detection.
LAG_COMP_MS=
# Player max HP.
HP_MAX=
# Respawn delay in ms after a kill.
RESPAWN_MS=
# Set to false to disable the in-arena scoreboard.
SCORE_ENABLED=true
# error | warn | info | debug
LOG_LEVEL=info
