# Copy to .env and fill in.  NEVER commit a real .env.
# (./install.sh does this for you interactively.)

# Your domain pointing (via an A record) at this server's IP.
# Caddy obtains a Let's Encrypt cert for this hostname automatically.
DOMAIN=quest.example.com

# Email Let's Encrypt uses for expiry/renewal notices.
ACME_EMAIL=you@example.com

# Multiplayer server admin identity — the ONE npub that gets admin powers
# (Update Now, etc.) on this instance. Accepts npub1... only, never an nsec
# (nsec is a private key — never paste it anywhere). Leave blank and nobody,
# including you, gets admin. See VPS_INSTALL.md §16.2a.
QUEST_ADMIN_NPUB=

# Public URL of this world — used by the Torii Gateway "travel" link and the
# server-side presence beacon (ADR-0094). Auto-set by install.sh from DOMAIN.
QUEST_PUBLIC_URL=

# Canonical login audience (F09): the exact URL the signing client puts in its
# NIP-98 `u` tag, i.e. <origin>/mp/session (e.g. https://quest.example.com/mp/session).
# Leave blank to auto-derive from QUEST_PUBLIC_URL's origin; only set it if /mp
# is mounted away from the domain root.
LOGIN_AUDIENCE_URL=

# Comma-separated wss:// relays the server publishes presence to. Blank = the
# built-in default relay set (plebeian, routstr, nos.lol, damus, primal, snort,
# nostr.mom). The node's OWN strfry relay (wss://<your-domain>/relay) is always
# prepended server-side as the primary home — do not list it here.
QUEST_NODE_RELAYS=

# --- Multiplayer tuning (optional — sane defaults if left blank) ---------
# Max simultaneous players per arena instance.
MAX_PEERS=32
# RETIRED since v0.2.895-alpha (Game Zone v2, ADR-0130) — ignored if set; the
# shared game zone sim owns lag compensation, HP and respawn timing.
MP_MODE=authoritative
LAG_COMP_MS=
HP_MAX=
RESPAWN_MS=
# Game Zone (ADR-0130): set GAMEZONE_ENABLED=false to disable combat on this node.
# BOT_COUNT_OVERRIDE / BOSS_COUNT_OVERRIDE / TEST_MODE still shape the bot roster.
# Set to false to disable the in-arena scoreboard.
SCORE_ENABLED=true
# error | warn | info | debug
LOG_LEVEL=info
